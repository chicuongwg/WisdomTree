# Copy to .env and adjust if needed. Defaults match docker-compose.yml.
DATABASE_URL=postgres://wisdomtree:wisdomtree@localhost:5432/wisdomtree

# Required only for the one-time, non-destructive bootstrap of a real empty DB.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_NAME=Initial Administrator
# BOOTSTRAP_SHARED_VAULT_NAME=Team Knowledge

# REQUIRED in production — the app refuses to boot without it. Signs session
# cookies and download tokens; outside production it falls back to a default
# that is published in this repo, so anyone could mint an admin session.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Required by the outbox safety cron. Send it as
# `Authorization: Bearer <CRON_SECRET>` to POST /api/cron/dispatch.
# Generate one independently from SESSION_SECRET.
# CRON_SECRET=

# Set only when every request reaches the app through a trusted reverse proxy
# that removes client-supplied forwarding headers and writes its own.
# TRUST_PROXY=1

# Inactivity timeout: a session idle longer than this (ms) reads as signed
# out. Default 30 minutes; the absolute cap stays SESSION_TTL_MS (7 days).
# SESSION_IDLE_MS=1800000

# Per-account traffic cap, enforced wherever a session resolves.
# Default 240 requests per 60s window.
# USER_RATE_LIMIT=240
# USER_RATE_WINDOW_MS=60000

# Google OIDC sign-in — all three set turns the real login on. Create the
# OAuth client at console.cloud.google.com (Credentials), with authorized
# redirect URI $APP_URL/api/auth/oidc/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://tree.example.org

# Dev-mode object storage: local filesystem behind the ObjectStore interface
# (docs/roadmap/demo-brief.md — demo substitution; V1 swaps in real S3).
FILE_STORAGE_DIR=./data/objects

# Optional delay before local extraction starts.
EXTRACTION_DELAY_MS=0

# Local AI Librarian — Ollama removed 2026-08-22; RAG will be reimplemented
# against the host llama.cpp server (OpenAI-compatible, http://127.0.0.1:8080/v1).
# See docs/RAG_REIMPLEMENTATION.md.
