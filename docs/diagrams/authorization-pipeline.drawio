<?xml version="1.0" encoding="utf-8"?>
<mxfile host="Electron" modified="2026-07-20T00:00:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="diagram_id" name="Authorization Pipeline">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1750" pageHeight="550" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b&gt;WISDOMTREE&lt;/b&gt; — AUTHORIZATION ENFORCEMENT PIPELINE — request authentication, route guard, authorize() check, query scoping, and audit (2026-07-29)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1670" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;i&gt;&lt;b&gt;How to read:&lt;/b&gt; left to right; green edges = happy path, red/gray edges = denial / exception path; checks are performed in the service layer before any DB action.&lt;/i&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1670" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=none;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;1 · Session Middleware&lt;/b&gt;&lt;hr&gt;Resolves cookie / token&lt;br&gt;Retrieves actor userId &amp;amp; role&lt;br&gt;Caches member spaceIds" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontColor=#000000;fontSize=10;arcSize=8;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="120" y="115" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;2 · Route Guard&lt;/b&gt;&lt;hr&gt;Identifies target capability&lt;br&gt;Extracts resource identifiers&lt;br&gt;Calls authorize() helper" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontColor=#000000;fontSize=10;arcSize=8;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="410" y="115" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;3 · authorize() Helper&lt;/b&gt;&lt;hr&gt;Validates role capability&lt;br&gt;Checks scope qualifier:&lt;br&gt;space | owned-or-assigned | self | global" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontColor=#000000;fontSize=10;arcSize=8;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="680" y="115" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;4 · Query Scoping&lt;/b&gt;&lt;hr&gt;List queries call scopedToSpaces()&lt;br&gt;Appends membership filters&lt;br&gt;(No-op for Admin/Op role)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontColor=#000000;fontSize=10;arcSize=8;strokeColor=#3B82F6;" vertex="1" parent="1">
          <mxGeometry x="990" y="115" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;5 · DB Transaction&lt;/b&gt;&lt;hr&gt;Applies mutation + writes audit_events&lt;br&gt;+ inserts outbox_events&lt;br&gt;(committed atomically)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontColor=#000000;fontSize=10;arcSize=8;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="1280" y="115" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="HTTP 200/201" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;arcSize=50;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="140" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="HTTP 401" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;arcSize=50;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="185" y="280" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="HTTP 404" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;arcSize=50;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="HTTP 403" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;arcSize=50;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;audit_events&lt;/b&gt;&lt;hr&gt;actor_id, action, resource_type&lt;br&gt;outcome = denied" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontColor=#000000;fontSize=10;arcSize=8;strokeColor=#C00000;" vertex="1" parent="1">
          <mxGeometry x="850" y="360" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#10B981;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c16" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;authenticated&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#10B981;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c17" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;checks guard&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#10B981;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c18" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;allowed&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#10B981;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c19" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;scoped&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#10B981;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c20" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;success&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#10B981;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c10">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c21" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;invalid session&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#C00000;strokeWidth=1.2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c11">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c22" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;read forbidden
(hide existence)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#C00000;strokeWidth=1.2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c12">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c23" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;write forbidden&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#C00000;strokeWidth=1.2;dashed=1;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c13">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c24" value="&lt;span style=&quot;background-color: #ffffff; padding: 2px 6px; border: 1px solid #d3d3d3; border-radius: 4px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);&quot;&gt;records denial&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontColor=#000000;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=6;endArrow=blockThin;endFill=1;strokeWidth=1.2;strokeColor=#475569;strokeWidth=1.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;Message:&lt;/b&gt; Read denials return 404 (Not Found) instead of 403 (Forbidden) to prevent leaking resource existence across space boundaries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#404040;fontColor=#000000;fontSize=11;arcSize=8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1670" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Colour roles&lt;/b&gt;: &lt;font color=&quot;#3B82F6&quot;&gt;&amp;#9632; authentication / check middleware&lt;/font&gt; · &lt;font color=&quot;#D97706&quot;&gt;&amp;#9632; database operations&lt;/font&gt; · &lt;font color=&quot;#C00000&quot;&gt;&amp;#9632; audit denial / error paths&lt;/font&gt;. Source of truth: docs/design/authorization-design.md." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1670" height="24" as="geometry" />
        </mxCell>
      </root>
