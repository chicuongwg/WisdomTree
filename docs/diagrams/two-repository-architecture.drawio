<mxfile host="Electron" modified="2026-07-20T00:00:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="diagram_id" name="Two-Repository Architecture">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="900" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b&gt;WISDOMTREE&lt;/b&gt; — TWO-REPOSITORY ARCHITECTURE — storage-first Source Repo + curated Knowledge Tree (2026-07-30)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;i&gt;&lt;b&gt;How to read:&lt;/b&gt; left frame = canonical evidence storage (the product core), right frame = curated knowledge; the purple promotion edge is the only path between them; export flows one-way out.&lt;/i&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="SOURCE REPO — the team storage home (canonical evidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969696;dashed=1;verticalAlign=top;align=left;spacing=8;fontSize=10;fontStyle=1;fontColor=#969696;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="620" height="560" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Spaces&lt;/b&gt; (membership-scoped)&lt;br&gt;team / personal / library space" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Library — store-first&lt;/b&gt;&lt;br&gt;items findable + downloadable at &amp;quot;stored&amp;quot;,&lt;br&gt;before any extraction or curation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="215" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Extraction&lt;/b&gt; (parallel)&lt;br&gt;parser-first, OCR fallback &amp;#8594; immutable&lt;br&gt;position-referenced text chunks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="335" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Curation&lt;/b&gt; (optional)&lt;br&gt;corrected text chain &amp;#8594; Markdown draft&lt;br&gt;&amp;#8594; Admin/Op review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="455" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;i&gt;Storage lifecycle, extraction status, and curation are three separate layers; rejection or failure never removes a stored item from Library.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#969696;fontColor=#555555;fontSize=10;dashed=1;arcSize=8;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="KNOWLEDGE TREE — curated Markdown (canonical in PostgreSQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#969696;dashed=1;verticalAlign=top;align=left;spacing=8;fontSize=10;fontStyle=1;fontColor=#969696;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="440" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Tree nodes + branches&lt;/b&gt;&lt;br&gt;tags, typed links, graph" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="130" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Verification&lt;/b&gt;&lt;br&gt;no_source / unverified / verified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="225" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;Promotions — provenance&lt;/b&gt;&lt;br&gt;source version &amp;#8594; node version&lt;br&gt;+ approver + excerpt chunks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="320" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Export layer&lt;/b&gt; (one-way)&lt;br&gt;tree &amp;#8594; content Git repo&lt;br&gt;backup, validation, snapshots" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="540" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Quartz static site&lt;/b&gt; (Phase 1.5)&lt;br&gt;selective read-only publish of verified&lt;br&gt;nodes flagged publish:true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1050" y="540" width="260" height="75" as="geometry" />
        </mxCell>
