        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;Message:&lt;/b&gt; The Source Repo is the product core, not a feeder pipeline: members live in Library at &amp;quot;stored&amp;quot;; promotion into the tree is optional and one-way, and the content repo is derived, never the source of truth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#404040;fontColor=#000000;fontSize=11;arcSize=8;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;Colour roles&lt;/b&gt; (repo theme, fixed): &lt;font color=&quot;#A855F7&quot;&gt;&amp;#9632; canonical app surfaces&lt;/font&gt; · &lt;font color=&quot;#10B981&quot;&gt;&amp;#9632; async processing&lt;/font&gt; · &lt;font color=&quot;#64748B&quot;&gt;&amp;#9632; supporting stage&lt;/font&gt; · purple heavy edge = the one promotion path · dashed = async / CI trigger. Source of truth: docs/system/two-repository-architecture.md." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1420" height="24" as="geometry" />
        </mxCell>
