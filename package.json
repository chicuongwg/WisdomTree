{
  "name": "wisdomtree",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "WisdomTree — storage-first knowledge platform (modular monolith: Next.js App Router + Drizzle + PostgreSQL)",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "prebuild": "node scripts/check-port-free.mjs",
    "build": "next build",
    "start": "next start",
    "setup:system": "sh scripts/install-system-deps.sh",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db/seed.ts",
    "db:up": "docker compose up -d db",
    "demo": "docker compose up -d db && npm run db:migrate && ALLOW_DESTRUCTIVE_SEED=1 npm run db:seed && npm run build && ENABLE_DEV_LOGIN=1 next start",
    "demo:dev": "docker compose up -d db && npm run db:migrate && ALLOW_DESTRUCTIVE_SEED=1 npm run db:seed && next dev --turbopack",
    "start:prod": "npm run db:migrate && next start",
    "proofs": "tsx scripts/proofs.ts",
    "vault:verify": "tsx scripts/vault-verify.ts",
    "vault:rebuild": "tsx --env-file-if-exists=.env scripts/vault-rebuild.ts",
    "test:authz": "tsx scripts/authz-matrix.test.ts",
    "test:sign": "tsx scripts/sign.test.ts",
    "test:boundaries": "tsx scripts/boundaries.test.ts",
    "test:contrast": "node scripts/contrast.test.mjs",
    "test:time": "tsx scripts/time.test.ts",
    "test:drawio": "node scripts/badge-overlap-audit.mjs",
    "test:unit": "tsx tests/run-all.ts tests/unit",
    "test:integration": "tsx tests/run-all.ts tests/integration",
    "test:e2e": "tsx tests/run-all.ts tests/e2e",
    "test:tests": "tsx tests/run-all.ts tests",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "npm run lint && npm run typecheck && npm run test:boundaries && npm run test:authz && npm run test:sign && npm run test:time && npm run test:contrast && npm run test:drawio"
  },
  "dependencies": {
    "@wisdomtree/graph-obsidian": "*",
    "@wisdomtree/identity": "*",
    "@wisdomtree/index-librarian": "*",
    "drizzle-orm": "^0.44.2",
    "fast-xml-parser": "5.10.1",
    "next": "^15.3.4",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
